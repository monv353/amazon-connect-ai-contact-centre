# Copy to .env, fill in, then: set -a; source .env; set +a; ./scripts/deploy.sh
# Never commit .env. No secrets belong in this repo.
AWS_PROFILE=my-sandbox
AWS_REGION=ap-southeast-1
STACK_NAME=arunika-cc-demo
# Must be globally unique; becomes https://<alias>.my.connect.aws (default: arunika-demo-<account suffix>)
INSTANCE_ALIAS=
# APAC geo inference profile (default) or e.g. global.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# AlwaysOpen (demo any time) or BusinessHours (08:00-22:00 WIB, shows after-hours branch)
AGENT_HOURS=AlwaysOpen
# Optional: creates Connect user "demo.agent" (8-64 chars, upper + lower + number)
DEMO_AGENT_PASSWORD=
